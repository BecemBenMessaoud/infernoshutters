# Public site key for Google reCAPTCHA v2 (checkbox). Exposed to the browser via Vite.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Server-only secret key. Set in Vercel Project Settings → Environment Variables.
# Do NOT prefix with VITE_ and do NOT commit the real value.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
